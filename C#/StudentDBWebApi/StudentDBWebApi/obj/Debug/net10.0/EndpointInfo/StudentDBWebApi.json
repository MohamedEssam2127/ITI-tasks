    "/api/Student": {
      "get": {
        "tags": [
          "Student"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Student"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Id": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Name": {
                    "pattern": "^[A-Za-z\\s]{6,15}$",
                    "type": "string"
                  },
                  "Age": {
                    "maximum": 18,
                    "minimum": 14,
                    "type": "integer",
                    "format": "int32"
                  },
                  "Address": {
                    "type": "string"
                  },
                  "Level": {
                    "type": "string"
                  },
                  "DOB": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "Img": {
                    "type": "string"
                  },
                  "Email": {
                    "type": "string"
                  },
                  "DepartmentId": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Department.Id": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Department.Name": {
                    "type": "string"
                  },
                  "Department.Location": {
                    "type": "string"
                  },
                  "Department.PhoneNumber": {
                    "type": "string"
                  },
                  "Department.Manager": {
                    "type": "string"
                  },
                  "Department.Students": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Student"
                    }
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "Id": {
                  "style": "form"
                },
                "Name": {
                  "style": "form"
                },
                "Age": {
                  "style": "form"
                },
                "Address": {
                  "style": "form"
                },
                "Level": {
                  "style": "form"
                },
                "DOB": {
                  "style": "form"
                },
                "Img": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "DepartmentId": {
                  "style": "form"
                },
                "Department.Id": {
                  "style": "form"
                },
                "Department.Name": {
                  "style": "form"
                },
                "Department.Location": {
                  "style": "form"
                },
                "Department.PhoneNumber": {
                  "style": "form"
                },
                "Department.Manager": {
                  "style": "form"
                },
                "Department.Students": {
                  "style": "form"
                },
                "image": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
